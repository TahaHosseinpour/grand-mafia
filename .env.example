# Copy to .env and fill in. Every key here is validated in src/server/env.ts.

NODE_ENV=development
# LOG_LEVEL=debug
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grand_mafia

# Long random strings: `openssl rand -base64 48`
JWT_SECRET=
CRON_SECRET=

# Canonical public URL, no trailing slash
BASE_URL=http://localhost:3000

# SMTP for account verification and password reset emails.
# Leave SMTP_HOST empty in development: emails are written to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="هیتلر مخفی <no-reply@example.com>"

# Directory for uploaded custom cardbacks (must persist across deploys)
UPLOADS_DIR=./uploads
