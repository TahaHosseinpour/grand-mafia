// Models `src/server/auth.ts` expects. Merge into prisma/schema.prisma (one
// schema file). Columns are snake_case via @map; ids are autoincrement Int,
// and userId is a number everywhere.
//
// No admin panel? Drop Admin, AdminPermission and the two enums.

model User {
  id           Int      @id @default(autoincrement())
  mobile       String   @unique @db.VarChar(15)
  email        String?  @unique @db.VarChar(255)
  fullName     String?  @map("full_name") @db.VarChar(100)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum AdminRole {
  super_admin
  admin
}

enum AdminAccessLevel {
  none
  read
  full
}

model Admin {
  id           Int               @id @default(autoincrement())
  email        String            @unique @db.VarChar(255)
  passwordHash String            @map("password_hash")
  role         AdminRole         @default(admin)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  permissions  AdminPermission[]

  @@map("admins")
}

// Permission per admin *page path* (see src/lib/admin-pages.ts).
model AdminPermission {
  id          Int              @id @default(autoincrement())
  adminId     Int              @map("admin_id")
  pagePath    String           @map("page_path") @db.VarChar(100)
  accessLevel AdminAccessLevel @default(none) @map("access_level")
  admin       Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, pagePath])
  @@map("admin_permissions")
}

// --- The example `posts` feature in templates/src/features/posts ------------

enum PostStatus {
  draft
  published
  archived
}

model Post {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(200)
  excerpt     String?       @db.VarChar(500)
  body        String
  status      PostStatus    @default(draft)
  publishAt   DateTime?     @map("publish_at")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  comments    PostComment[]

  @@index([status, publishedAt])
  @@map("posts")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_comments")
}
