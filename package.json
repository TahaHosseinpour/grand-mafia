{
  "name": "grand-mafia",
  "description": "نسخه فارسی بازی هیتلر مخفی — Next.js + Socket.IO + Prisma",
  "version": "2.0.0",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --import ./scripts/register-hooks.mjs server.ts",
    "dev:pretty": "pnpm dev | pino-pretty",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx --import ./scripts/register-hooks.mjs server.ts",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "socket.io": "~4.8.4",
    "socket.io-client": "~4.8.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "vazirmatn": "^33.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
